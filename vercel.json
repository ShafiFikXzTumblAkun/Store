{
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/autoplay\\.mp3$", "dest": "/autoplay.mp3" },
    { "src": "^/autoplay2\\.mp3$", "dest": "/autoplay2.mp3" },
    { "src": "^/autoplay3\\.mp3$", "dest": "/autoplay3.mp3" },
    { "src": "/500", "dest": "/500.html" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
